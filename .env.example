# Copy to .env and fill in real values. Never commit .env.

# --- AI risk gate ---------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
# How often DeepSeek is asked for a verdict (seconds).
AI_INTERVAL_SECS=60

# --- HTX ------------------------------------------------------------------
# Required only for live orders; paper mode runs without credentials.
HTX_API_KEY=your-htx-api-key
HTX_API_SECRET=your-htx-api-secret

# --- Market scanner -------------------------------------------------------
# Every SCAN_INTERVAL_SECS the bot re-ranks all HTX USDT spot pairs by 24h
# amplitude, drops anything below the volume floor and streams the top N.
SCAN_INTERVAL_SECS=90
SCAN_MIN_QUOTE_VOLUME_USDT=1000000
# Skip pairs whose quoted spread at scan time is wider than this (bps).
# 40 bps is the default ceiling for a trade whose round trip must survive
# fees; 0 disables the filter.
SCAN_MAX_SPREAD_BPS=40
SCAN_TOP_N=12
# Optional: pairs that always stay on the watchlist, comma-separated.
# SCAN_SYMBOLS=btcusdt

# Optional: pin one market-data endpoint instead of the failover list.
# HTX_WS_URL=wss://api.htx.com/ws
# Optional: REST base URL used by the scanner and signed requests.
# HTX_REST_URL=https://api.htx.com

# --- Strategy (trend follower) --------------------------------------------
# Bars of STRAT_BAR_SECS are aggregated from the trade stream; every indicator
# moves only on a bar close. An entry needs the whole trend filter:
#   EMA fast > EMA slow, price > EMA trend, ADX >= STRAT_ADX_MIN, +DI > -DI
#   and price above the rolling VWAP.
# Two entries are possible: a Donchian breakout above STRAT_BREAKOUT_BARS, or a
# pullback that reclaims the fast EMA inside an uptrend. Volume never blocks an
# entry; a spike is only recorded as extra conviction.
STRAT_BAR_SECS=60
STRAT_EMA_FAST=9
STRAT_EMA_SLOW=21
STRAT_EMA_TREND=50
STRAT_ADX_PERIOD=14
STRAT_ADX_MIN=20
STRAT_ATR_PERIOD=14
STRAT_BREAKOUT_BARS=20
STRAT_VWAP_BARS=30
# How many recent bars may count as the dip of a pullback.
STRAT_PULLBACK_BARS=4
# Minimum seconds between two entries on the same symbol.
STRAT_COOLDOWN_SECS=30

# --- Execution ------------------------------------------------------------
# off  = log signals only
# paper = simulate fills against the live top of book (default)
# live  = send real orders to HTX (requires HTX_API_KEY / HTX_API_SECRET)
EXECUTION_MODE=paper

# Sizing and risk, quote currency = USDT.
EXEC_ORDER_NOTIONAL_USDT=25
EXEC_MIN_NOTIONAL_USDT=5
EXEC_MAX_ORDER_NOTIONAL_USDT=50
EXEC_MAX_POSITION_NOTIONAL_USDT=50
EXEC_MAX_DAILY_LOSS_USDT=20

# Exits: ride the trend. The trailing stop sits EXEC_TRAIL_ATR_MULT x ATR(14)
# below the best bid since the entry; the hard stop is the 0.7% emergency brake;
# the position is also closed when the trend filter flips. There is no fixed
# take-profit and no time-based exit.
EXEC_TRAIL_ATR_MULT=2
# Trail distance until the ATR of the symbol is warm. Keep it wider than
# EXEC_STOP_LOSS_PCT so the emergency brake is always reachable.
EXEC_TRAIL_FALLBACK_PCT=1.5
EXEC_STOP_LOSS_PCT=0.7
# Close the position when EMA9/EMA21/EMA50 or ADX turn against the long.
EXEC_TREND_EXIT=true

# Timing.
EXEC_COOLDOWN_SECS=10
EXEC_GATE_TTL_SECS=120
# Cancel an unfilled entry after this many seconds.
EXEC_ORDER_TTL_SECS=30
# A resting entry is also cancelled as soon as the market runs this many bps
# above its limit: at that point the signal no longer describes the price.
# 0 disables the check.
EXEC_ENTRY_MAX_CHASE_BPS=20

# Entry routing.
# Breakouts are momentum, so they take liquidity (buy-market) instead of
# leaving a passive bid behind the move. Set to false to make every entry
# post-only.
EXEC_BREAKOUT_TAKER=true
# Pullbacks stay post-only: the buy rests this many venue steps above the best
# bid to join the front of the queue. It never crosses the spread — on a
# one-tick spread the offset is dropped and the bid itself is used.
EXEC_MAKER_OFFSET_TICKS=1

# Order semantics: a breakout entry is a market order; a pullback entry is
# post-only (buy-limit-maker). Every exit — ATR trailing stop, hard stop-loss
# and trend flip — is a market order so it always gets out.
#
# Venue mechanics: BPS = basis points (1 bps = 0.01%).
EXEC_SLIPPAGE_BPS=5
EXEC_FEE_BPS=20
# Fallback steps, used only if a symbol is missing from HTX metadata: the
# scanner reads per-pair precision from /v1/common/symbols automatically.
EXEC_BASE_STEP=0.000001
EXEC_PRICE_STEP=0.01

# Simulated starting balance.
PAPER_START_USDT=1000
